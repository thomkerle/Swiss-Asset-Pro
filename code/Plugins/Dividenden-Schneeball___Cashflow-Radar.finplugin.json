    "title": "Dividenden-Schneeball & Cashflow-Radar",
    "category": "Dividenden",
    "code": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <link href=\"https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css\" rel=\"stylesheet\">\n    <style>\n        body { \n            background: #ffffff; \n            font-family: system-ui, -apple-system, sans-serif; \n        }\n        .dark body { background: #020617; }\n        input[type=\"range\"] { \n            -webkit-appearance: none; \n            height: 5px; \n            border-radius: 9999px; \n            background: #e2e8f0; \n            outline: none; \n        }\n        .dark input[type=\"range\"] { background: #334155; }\n        input[type=\"range\"]::-webkit-slider-thumb { \n            -webkit-appearance: none; \n            width: 15px; \n            height: 15px; \n            border-radius: 50%; \n            background: #059669; \n            cursor: pointer; \n        }\n    </style>\n</head>\n<body class=\"p-6 md:p-8 max-w-7xl mx-auto bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors\">\n\n    <!-- Report Header Bar -->\n    <div class=\"flex flex-col sm:flex-row justify-between items-start sm:items-center pb-5 mb-6 border-b border-gray-200 dark:border-slate-800 gap-4\">\n        <div>\n            <h2 id=\"repTitle\" class=\"text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3\">\n                <svg class=\"w-7 h-7 text-emerald-600 dark:text-emerald-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                </svg>\n                <span id=\"titleText\"></span>\n            </h2>\n            <p id=\"repSub\" class=\"text-sm text-gray-500 dark:text-gray-400 mt-1\"></p>\n        </div>\n        <button id=\"pdfBtn\" class=\"bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-5 rounded-xl shadow-sm text-xs transition-colors flex items-center gap-2 cursor-pointer shrink-0\">\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"></path>\n            </svg>\n            <span id=\"lblPdfBtn\"></span>\n        </button>\n    </div>\n\n    <!-- Erklärungs- & Interpretationsbox -->\n    <div id=\"explBox\" class=\"mb-8 p-5 rounded-2xl bg-emerald-50/60 dark:bg-emerald-950/20 border border-emerald-200/80 dark:border-emerald-800/50 text-xs text-emerald-950 dark:text-emerald-300 leading-relaxed shadow-xs flex items-start gap-3\">\n        <svg class=\"w-5 h-5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n        </svg>\n        <div id=\"explText\"></div>\n    </div>\n\n    <!-- FinBundle KPI Dashboard Grid -->\n    <div id=\"kpiGrid\" class=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8 p-1\"></div>\n\n    <!-- Hauptbereich: Parameter & Visualisierungen -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8\">\n        \n        <!-- Parameter-Spalte links -->\n        <div class=\"lg:col-span-4 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-5\">\n            <div class=\"flex justify-between items-center pb-3 border-b border-gray-100 dark:border-slate-800\">\n                <h3 id=\"headParam\" class=\"font-bold text-base text-slate-800 dark:text-slate-200 flex items-center gap-2\">\n                    <svg class=\"w-4 h-4 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4\"></path>\n                    </svg>\n                    <span id=\"lblParamTitle\"></span>\n                </h3>\n                <span id=\"lblSecCountBadge\" class=\"text-[10px] bg-emerald-100 dark:bg-emerald-900/40 text-emerald-800 dark:text-emerald-300 font-bold px-2.5 py-0.5 rounded-full font-mono\"></span>\n            </div>\n\n            <!-- Filter-Toggles -->\n            <div class=\"space-y-2 p-3 bg-gray-50 dark:bg-slate-800/60 rounded-xl border border-gray-200 dark:border-slate-700/60 text-xs\">\n                <label class=\"flex items-center gap-2 font-medium text-slate-800 dark:text-slate-200 cursor-pointer\">\n                    <input type=\"checkbox\" id=\"chkIncludeInterest\" checked class=\"w-4 h-4 text-blue-600 rounded cursor-pointer\">\n                    <span id=\"lblIncludeInterest\"></span>\n                </label>\n                <label class=\"flex items-center gap-2 font-medium text-slate-800 dark:text-slate-200 cursor-pointer\">\n                    <input type=\"checkbox\" id=\"chkOnlyPaying\" checked class=\"w-4 h-4 text-emerald-600 rounded cursor-pointer\">\n                    <span id=\"lblOnlyPaying\"></span>\n                </label>\n                <label class=\"flex items-center gap-2 font-medium text-slate-800 dark:text-slate-200 cursor-pointer\">\n                    <input type=\"checkbox\" id=\"chkIncludeArchived\" checked class=\"w-4 h-4 text-blue-600 rounded cursor-pointer\">\n                    <span id=\"lblIncludeArchived\"></span>\n                </label>\n            </div>\n\n            <!-- Schieberegler + Zahlenfelder -->\n            <div class=\"space-y-4\">\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblBaseAnnualHead\" class=\"font-medium text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numBaseAnnual\" value=\"4032\" step=\"50\" class=\"w-24 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-emerald-600 dark:text-emerald-400\">\n                    </div>\n                    <input id=\"slideBaseAnnual\" type=\"range\" min=\"100\" max=\"30000\" step=\"50\" value=\"4032\" class=\"w-full\">\n                </div>\n\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblDivGrowthHead\" class=\"font-medium text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numDivGrowth\" value=\"6.0\" step=\"0.25\" class=\"w-20 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-emerald-600 dark:text-emerald-400\">\n                    </div>\n                    <input id=\"slideDivGrowth\" type=\"range\" min=\"0.0\" max=\"15.0\" step=\"0.5\" value=\"6.0\" class=\"w-full\">\n                </div>\n\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblReinvestHead\" class=\"font-medium text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numReinvest\" value=\"300\" step=\"50\" class=\"w-24 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-blue-600 dark:text-blue-400\">\n                    </div>\n                    <input id=\"slideReinvest\" type=\"range\" min=\"0\" max=\"3000\" step=\"50\" value=\"300\" class=\"w-full\">\n                </div>\n\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblReinvestYieldHead\" class=\"font-medium text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numReinvestYield\" value=\"3.5\" step=\"0.1\" class=\"w-20 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-amber-600 dark:text-amber-400\">\n                    </div>\n                    <input id=\"slideReinvestYield\" type=\"range\" min=\"1.0\" max=\"8.0\" step=\"0.25\" value=\"3.5\" class=\"w-full\">\n                </div>\n\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblHorizonHead\" class=\"font-medium text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numHorizon\" value=\"20\" min=\"5\" max=\"30\" step=\"1\" class=\"w-16 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200\">\n                    </div>\n                    <input id=\"slideHorizon\" type=\"range\" min=\"5\" max=\"30\" step=\"1\" value=\"20\" class=\"w-full\">\n                </div>\n            </div>\n        </div>\n\n        <!-- Rechte Seite: Charts -->\n        <div class=\"lg:col-span-8 flex flex-col gap-6\">\n            <div class=\"grid grid-cols-1 xl:grid-cols-2 gap-6\">\n                <!-- Chart 1: Monatlicher Cashflow -->\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm\">\n                    <h3 id=\"headChart1\" class=\"font-bold text-base mb-4 flex items-center gap-2 text-slate-800 dark:text-slate-200\">\n                        <svg class=\"w-4 h-4 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path></svg>\n                        <span id=\"lblChart1Title\"></span>\n                    </h3>\n                    <div style=\"height: 230px;\"><canvas id=\"snowballChart\"></canvas></div>\n                </div>\n\n                <!-- Chart 2: Akkumulierter Vermögenszufluss -->\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm\">\n                    <h3 id=\"headChart2\" class=\"font-bold text-base mb-4 flex items-center gap-2 text-slate-800 dark:text-slate-200\">\n                        <svg class=\"w-4 h-4 text-blue-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"></path></svg>\n                        <span id=\"lblChart2Title\"></span>\n                    </h3>\n                    <div style=\"height: 230px;\"><canvas id=\"accumulatedChart\"></canvas></div>\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <!-- Asset-Transparenztabelle -->\n    <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden mb-8\">\n        <div class=\"p-5 border-b border-gray-100 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-800/30 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3\">\n            <div>\n                <h3 class=\"font-bold text-base text-slate-800 dark:text-slate-200 flex items-center gap-2\" id=\"headAssetTable\">\n                    <svg class=\"w-4 h-4 text-slate-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"></path></svg>\n                    <span id=\"lblAssetTableTitle\"></span>\n                </h3>\n                <p id=\"lblAssetTableSub\" class=\"text-xs text-gray-500 dark:text-gray-400 mt-0.5\"></p>\n            </div>\n            <div class=\"flex items-center gap-3\">\n                <input type=\"text\" id=\"assetSearchInput\" placeholder=\"Suchen...\" class=\"p-1.5 px-3 border border-gray-200 dark:border-slate-700 rounded-lg text-xs bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-200 outline-none focus:ring-1 focus:ring-emerald-500\">\n                <span id=\"lblAssetFilterNotice\" class=\"text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400\"></span>\n            </div>\n        </div>\n        <div class=\"overflow-x-auto max-h-72 overflow-y-auto\">\n            <table class=\"w-full text-left text-sm font-mono\">\n                <thead class=\"bg-white dark:bg-slate-900 text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-slate-800 text-xs uppercase font-bold sticky top-0 z-10 shadow-sm\">\n                    <tr>\n                        <th class=\"p-3.5 font-sans\" id=\"thAsName\"></th>\n                        <th class=\"p-3.5 font-sans\" id=\"thAsBank\"></th>\n                        <th class=\"p-3.5 font-sans\" id=\"thAsClass\"></th>\n                        <th class=\"p-3.5 text-right\" id=\"thAsValue\"></th>\n                        <th class=\"p-3.5 text-right\" id=\"thAsDiv\"></th>\n                        <th class=\"p-3.5 text-right\" id=\"thAsYield\"></th>\n                    </tr>\n                </thead>\n                <tbody id=\"assetTableBody\" class=\"divide-y divide-gray-100 dark:divide-slate-800 text-xs\"></tbody>\n            </table>\n        </div>\n    </div>\n\n    <script>\n        if (window.parent && window.parent.document.documentElement.classList.contains('dark')) {\n            document.documentElement.classList.add('dark');\n        }\n\n        const api = window.FinSPA_API;\n        const LANG = (api && api.getLanguage && api.getLanguage()) || 'de';\n\n        const I18N = {\n            de: {\n                title: 'Dividenden-Schneeball & Cashflow-Radar',\n                sub: 'Monatlicher passiver Cashflow und exponentielles Wachstum aus Wertschriften',\n                exp: 'Bericht exportieren (PDF)',\n                expl: '<strong>Berechnungslogik analog PassiveIncomeReport:</strong> Es werden ausschliesslich Wertschriften analysiert. Zins- und Dividendenbuchungen auf reinen Verrechnungskonten werden als interne Geldtransfers (Shift) gewertet und nicht doppelt erfasst. Die 12M Prognose basiert exakt auf den hinterlegten Forward-Yields Ihrer Wertschriften.',\n                p: 'Wachstums- & Simulationsparameter',\n                onlyPay: 'Nur Titel mit Ertrag anzeigen',\n                incArch: 'Archivierte Wertpapiere einbeziehen',\n                incInterest: 'Zinsen einbeziehen (analog Gesamtertrag)',\n                baseAnnual: 'Aktuelle Jahresdividende (Basis CHF)',\n                grw: 'Dividendenwachstum p.a. (%)',\n                reinv: 'Monatlicher Zukauf / Sparplan',\n                reinvYld: 'Ausschüttungsrendite Neukäufe (%)',\n                hor: 'Anlagehorizont (Jahre)',\n                ch1: 'Monatlicher Dividenden-Cashflow über die Zeit',\n                ch2: 'Akkumulierter Vermögenszufluss (Kumuliert)',\n                kRec: 'Gesamtertrag (Historisch)',\n                kRecSubDividendsOnly: 'Reine Dividenden',\n                kRecSubAll: 'Dividenden + Zinsen',\n                kCur: 'Monats-Cashflow (Aktuell)',\n                kCurSub: '12M Prognose / 12',\n                kEnd: 'Monats-Cashflow (Zieljahr)',\n                kEndSub: 'Prognose nach Horizont',\n                kDbl: 'Verdopplungszeit',\n                kDblSub: 'Nach der 72er-Regel',\n                tblHead: 'Transparenz: Wertpapierträger & Ertragstitel',\n                tblSub: 'Strikter Ausschluss von Liquiditäts- und Verrechnungskonten (Keine Scheinrenditen)',\n                countNotice: (c, a) => `${c} Titel (${a} aktiv, ${c - a} archiviert)`,\n                badgeArchived: 'Archiviert',\n                thAsName: 'Wertschrift / Titel',\n                thAsBank: 'Depot / Bank',\n                thAsClass: 'Klasse',\n                thAsValue: 'Kurswert (CHF)',\n                thAsDiv: 'Erfasster Ertrag (CHF)',\n                thAsYield: 'Forward Yield / Rendite',\n                searchPlaceholder: 'Titel suchen...',\n                perMonth: '/Mt.',\n                yUnit: 'Jahre',\n                inYears: (y) => `In ca. ${y} Jahren`,\n                noHoldings: 'Keine Wertschriften mit diesen Kriterien gefunden.'\n            },\n            en: {\n                title: 'Dividend Snowball & Cashflow Radar',\n                sub: 'Passive monthly cashflow and compounding growth from securities',\n                exp: 'Export Report (PDF)',\n                expl: '<strong>Calculation logic aligned with PassiveIncomeReport:</strong> Analyzes exclusively securities. Dividend entries on checking and cash accounts are classified as internal transfers (shift) to eliminate duplicates. The 12M projection derives directly from your portfolio forward yields.',\n                p: 'Growth & Simulation Parameters',\n                onlyPay: 'Show only holdings with income',\n                incArch: 'Include archived securities',\n                incInterest: 'Include interest income (total passive income)',\n                baseAnnual: 'Current Annual Dividends (Baseline CHF)',\n                grw: 'Dividend Growth p.a. (%)',\n                reinv: 'Monthly New Contribution',\n                reinvYld: 'Yield on New Purchases (%)',\n                hor: 'Investment Horizon (Years)',\n                ch1: 'Monthly Dividend Stream Projection',\n                ch2: 'Cumulative Passive Income Stream',\n                kRec: 'Total Received (History)',\n                kRecSubDividendsOnly: 'Pure dividends',\n                kRecSubAll: 'Dividends + Interest',\n                kCur: 'Monthly Cashflow (Current)',\n                kCurSub: '12M Forecast / 12',\n                kEnd: 'Monthly Cashflow (Target Year)',\n                kEndSub: 'Projected at horizon',\n                kDbl: 'Doubling Time',\n                kDblSub: 'Rule of 72 Metric',\n                tblHead: 'Transparency: Securities & Yield Holdings',\n                tblSub: 'Cash, checking, and settlement accounts strictly excluded',\n                countNotice: (c, a) => `${c} holdings (${a} active, ${c - a} archived)`,\n                badgeArchived: 'Archived',\n                thAsName: 'Asset Name',\n                thAsBank: 'Broker / Bank',\n                thAsClass: 'Class',\n                thAsValue: 'Market Value (CHF)',\n                thAsDiv: 'Recorded Income (CHF)',\n                thAsYield: 'Forward Yield',\n                searchPlaceholder: 'Search holdings...',\n                perMonth: '/Mo',\n                yUnit: 'Years',\n                inYears: (y) => `In approx. ${y} years`,\n                noHoldings: 'No securities found matching criteria.'\n            },\n            fr: {\n                title: 'Radar de dividendes et cash-flow',\n                sub: 'Flux de revenus passifs mensuels et croissance des dividendes',\n                exp: 'Exporter en PDF',\n                expl: '<strong>Logique conforme au rapport PassiveIncome:</strong> Seuls les titres réels sont analysés. Les flux sur comptes de liquidités sont traités comme de simples transferts. La projection à 12 mois est calculée selon le forward yield déclaré.',\n                p: 'Paramètres de croissance',\n                onlyPay: 'Afficher uniquement les titres avec revenus',\n                incArch: 'Inclure les titres archivés',\n                incInterest: 'Inclure les intérêts (revenu passif total)',\n                baseAnnual: 'Dividendes annuels actuels (Base CHF)',\n                grw: 'Croissance des dividendes (%)',\n                reinv: 'Réinvestissement mensuel',\n                reinvYld: 'Rendement des nouveaux achats (%)',\n                hor: 'Horizon (Ans)',\n                ch1: 'Flux mensuel de dividendes projeté',\n                ch2: 'Revenus passifs cumulés',\n                kRec: 'Dividendes historiques',\n                kRecSubDividendsOnly: 'Dividendes purs',\n                kRecSubAll: 'Dividendes + Intérêts',\n                kCur: 'Cash-flow mensuel actuel',\n                kCurSub: 'Prévision 12M / 12',\n                kEnd: 'Cash-flow mensuel futur',\n                kEndSub: 'Projection au terme',\n                kDbl: 'Temps de doublement',\n                kDblSub: 'Selon la règle des 72',\n                tblHead: 'Transparence: Titres analysés',\n                tblSub: 'Exclusion stricte des comptes courants et de trésorerie',\n                countNotice: (c, a) => `${c} titres (${a} actifs, ${c - a} archivés)`,\n                badgeArchived: 'Archivé',\n                thAsName: 'Titre / Actif',\n                thAsBank: 'Dépôt / Banque',\n                thAsClass: 'Classe',\n                thAsValue: 'Valeur (CHF)',\n                thAsDiv: 'Revenus perçus (CHF)',\n                thAsYield: 'Rendement prévisionnel',\n                searchPlaceholder: 'Rechercher...',\n                perMonth: '/Mois',\n                yUnit: 'Ans',\n                inYears: (y) => `Dans env. ${y} ans`,\n                noHoldings: 'Aucun titre trouvé.'\n            },\n            it: {\n                title: 'Radar dividendi e cashflow passivo',\n                sub: 'Flusso di cassa passivo mensile e crescita composta da titoli',\n                exp: 'Esporta in PDF',\n                expl: '<strong>Logica di calcolo allineata a PassiveIncomeReport:</strong> Vengono analizzati esclusivamente titoli reali. I movimenti sui conti correnti sono esclusi come trasferimenti interni. La stima a 12 mesi riflette il rendimento atteso dei titoli.',\n                p: 'Parametri di crescita',\n                onlyPay: 'Mostra solo titoli con proventi',\n                incArch: 'Includi titoli archiviati',\n                incInterest: 'Includi interessi (reddito passivo totale)',\n                baseAnnual: 'Dividendi annui attuali (Base CHF)',\n                grw: 'Crescita dividendi p.a. (%)',\n                reinv: 'Reinvestimento mensile',\n                reinvYld: 'Rendimento nuovi acquisti (%)',\n                hor: 'Orizzonte (Anni)',\n                ch1: 'Flusso mensile dei dividendi nel tempo',\n                ch2: 'Flusso di reddito passivo cumulato',\n                kRec: 'Dividendi incassati',\n                kRecSubDividendsOnly: 'Solo dividendi',\n                kRecSubAll: 'Dividendi + Interessi',\n                kCur: 'Cashflow mensile attuale',\n                kCurSub: 'Stima 12 mesi / 12',\n                kEnd: 'Cashflow mensile obiettivo',\n                kEndSub: 'Proiezione al termine',\n                kDbl: 'Tempo di raddoppio',\n                kDblSub: 'Regola del 72',\n                tblHead: 'Trasparenza: Titoli analizzati',\n                tblSub: 'Esclusione rigorosa di conti correnti e liquidità',\n                countNotice: (c, a) => `${c} titoli (${a} attivi, ${c - a} archiviati)`,\n                badgeArchived: 'Archiviato',\n                thAsName: 'Titolo / Asset',\n                thAsBank: 'Deposito / Banca',\n                thAsClass: 'Classe',\n                thAsValue: 'Valore (CHF)',\n                thAsDiv: 'Proventi percepiti (CHF)',\n                thAsYield: 'Rendimento atteso',\n                searchPlaceholder: 'Cerca titoli...',\n                perMonth: '/Mese',\n                yUnit: 'Anni',\n                inYears: (y) => `Tra circa ${y} anni`,\n                noHoldings: 'Nessun titolo trovato.'\n            }\n        };\n\n        const t = (k) => (I18N[LANG] && I18N[LANG][k]) || I18N['de'][k] || k;\n        let barChart = null, lineChart = null, lastRes = null;\n        let userHasEditedBase = false;\n        let cachedHoldings = [];\n\n        function fmt(v) { return api ? api.formatCurrency(v) : 'CHF ' + Math.round(v).toLocaleString('de-CH'); }\n\n        function syncPair(slideId, numId, cb) {\n            const s = document.getElementById(slideId), n = document.getElementById(numId);\n            s.addEventListener('input', () => { \n                n.value = s.value; \n                if (slideId === 'slideBaseAnnual') userHasEditedBase = true;\n                cb(); \n            });\n            n.addEventListener('input', () => { \n                s.value = n.value; \n                if (numId === 'numBaseAnnual') userHasEditedBase = true;\n                cb(); \n            });\n        }\n\n        function initUI() {\n            document.getElementById('titleText').innerText = t('title');\n            document.getElementById('repSub').innerText = t('sub');\n            document.getElementById('lblPdfBtn').innerText = t('exp');\n            document.getElementById('explText').innerHTML = t('expl');\n            document.getElementById('lblParamTitle').innerText = t('p');\n            document.getElementById('lblOnlyPaying').innerText = t('onlyPay');\n            document.getElementById('lblIncludeArchived').innerText = t('incArch');\n            document.getElementById('lblIncludeInterest').innerText = t('incInterest');\n            document.getElementById('lblBaseAnnualHead').innerText = t('baseAnnual');\n            document.getElementById('lblDivGrowthHead').innerText = t('grw');\n            document.getElementById('lblReinvestHead').innerText = t('reinv');\n            document.getElementById('lblReinvestYieldHead').innerText = t('reinvYld');\n            document.getElementById('lblHorizonHead').innerText = t('hor');\n            document.getElementById('lblChart1Title').innerText = t('ch1');\n            document.getElementById('lblChart2Title').innerText = t('ch2');\n            document.getElementById('lblAssetTableTitle').innerText = t('tblHead');\n            document.getElementById('lblAssetTableSub').innerText = t('tblSub');\n            document.getElementById('assetSearchInput').placeholder = t('searchPlaceholder');\n            document.getElementById('thAsName').innerText = t('thAsName');\n            document.getElementById('thAsBank').innerText = t('thAsBank');\n            document.getElementById('thAsClass').innerText = t('thAsClass');\n            document.getElementById('thAsValue').innerText = t('thAsValue');\n            document.getElementById('thAsDiv').innerText = t('thAsDiv');\n            document.getElementById('thAsYield').innerText = t('thAsYield');\n\n            syncPair('slideBaseAnnual', 'numBaseAnnual', run);\n            syncPair('slideDivGrowth', 'numDivGrowth', run);\n            syncPair('slideReinvest', 'numReinvest', run);\n            syncPair('slideReinvestYield', 'numReinvestYield', run);\n            syncPair('slideHorizon', 'numHorizon', run);\n            document.getElementById('chkOnlyPaying').addEventListener('change', run);\n            document.getElementById('chkIncludeArchived').addEventListener('change', run);\n            document.getElementById('chkIncludeInterest').addEventListener('change', run);\n            document.getElementById('assetSearchInput').addEventListener('input', renderTable);\n        }\n\n        // Sprachunabhängiger Matcher für Dividenden- & Ertragsbuchungen\n        function isDividendBooking(bk, includeInterest = false) {\n            if (!bk) return false;\n            const t = String(bk.type || bk.normType || '').toLowerCase().trim();\n            const c = String(bk.normCategory || bk.category || bk.subCategory || '').toLowerCase().trim();\n            const cm = String(bk.comment || '').toLowerCase().trim();\n\n            if (['gebühr', 'fee', 'frais', 'spese'].includes(t)) return false;\n\n            // Mehrsprachige Wortstämme für Dividenden & Ausschüttungen\n            const divKeywords = ['divid', 'ausschütt', 'distrib', 'cedola', 'coupon'];\n            const isDiv = divKeywords.some(kw => t.includes(kw) || c.includes(kw) || cm.includes(kw));\n            if (isDiv) return true;\n\n            if (includeInterest) {\n                const interestKeywords = ['zins', 'interest', 'intérêt', 'interess'];\n                return interestKeywords.some(kw => t.includes(kw) || c.includes(kw));\n            }\n\n            return false;\n        }\n\n        // Traversiert den vollständigen Datenbaum inkl. archivierter Nodes\n        function getAllAssetsIncludingArchived() {\n            const data = (api && typeof api._getData === 'function') ? api._getData() : (window.finspaData || {});\n            const assets = [];\n            function traverse(node, currentBank) {\n                let bName = currentBank;\n                if (node.type === 'bank') bName = node.name;\n                if (node.type === 'asset') {\n                    assets.push({ ...node, bankName: bName });\n                }\n                if (node.children) node.children.forEach(child => traverse(child, bName));\n            }\n            (data.banks || []).forEach(b => traverse(b, 'Unbekannt'));\n            return assets;\n        }\n\n        function extractDataEngineAligned() {\n            const allAssets = getAllAssetsIncludingArchived();\n            const todayStr = new Date().toISOString().split('T')[0];\n\n            const incArchived = document.getElementById('chkIncludeArchived').checked;\n            const onlyPaying = document.getElementById('chkOnlyPaying').checked;\n            const includeInterest = document.getElementById('chkIncludeInterest').checked;\n\n            let totalHistDiv = 0;\n            let forecast12m = 0;\n            const assetDivMap = {};\n\n            // 1. Erträge ermitteln (analog PassiveIncomeReport.jsx)\n            allAssets.forEach(asset => {\n                const ac = (asset.assetClass || '').toLowerCase();\n                const isSec = (api && typeof api._isSecurity === 'function')\n                    ? api._isSecurity(ac)\n                    : ['stock', 'fund', 'managed_fund', 'pension_fund', 'pension_3a_fund', 'pension_3a_managed'].includes(ac);\n                \n                const isLiquid = (api && typeof api._isAssetLiquid === 'function')\n                    ? api._isAssetLiquid(asset)\n                    : (['cash', 'account', 'bank'].includes(ac) || asset.isLiquid === true);\n\n                // Ausschliesslich Wertschriften (keine Cashkonten)\n                (asset.bookings || []).forEach(bk => {\n                    if (isDividendBooking(bk, includeInterest)) {\n                        // Buchungen auf reinen Geldkonten ausschliessen (Shift)\n                        if (isSec || !isLiquid) {\n                            const bkRate = bk.bookingExchangeRate ? parseFloat(bk.bookingExchangeRate) : 0;\n                            const assetRate = parseFloat(asset.exchangeRate || 1);\n                            const appliedRate = (bkRate !== 0 && bkRate !== 1) ? bkRate : assetRate;\n                            const val = Number(bk.amount || 0) * (appliedRate || 1);\n\n                            // Wenn archivierte ausgeschlossen sind, historische Dividenden von archivierten nicht summieren\n                            if (incArchived || !asset.isArchived) {\n                                totalHistDiv += val;\n                            }\n                            assetDivMap[asset.name] = (assetDivMap[asset.name] || 0) + val;\n                        }\n                    }\n                });\n\n                // 2. 12M Forward Yield (exakt wie PassiveIncomeReport.jsx)\n                if (!asset.isArchived && isSec) {\n                    const yieldPct = parseFloat(asset.forwardYield || 0);\n                    if (yieldPct > 0) {\n                        const taxPct = parseFloat(asset.totalTaxes || 0);\n                        let curNative = (api && typeof api.getAssetRawValueAtDate === 'function')\n                            ? api.getAssetRawValueAtDate(asset, todayStr)\n                            : 0;\n\n                        if (!curNative || curNative === 0) {\n                            const bVal = (api && typeof api.getAssetValueAtDate === 'function')\n                                ? api.getAssetValueAtDate(asset, todayStr, allAssets)\n                                : 0;\n                            const fx = parseFloat(String(asset.exchangeRate || 1).replace(',', '.'));\n                            curNative = fx !== 0 ? bVal / fx : bVal;\n                        }\n\n                        if (curNative > 0) {\n                            const grossNative = curNative * (yieldPct / 100);\n                            const netNative = grossNative * (1 - (taxPct / 100));\n                            const fxRate = parseFloat(String(asset.exchangeRate || 1).replace(',', '.'));\n                            forecast12m += netNative * (fxRate || 1);\n                        }\n                    }\n                }\n            });\n\n            // 3. Wertpapierträger für Tabelle erfassen\n            const holdings = [];\n            let activeCount = 0;\n\n            allAssets.forEach(a => {\n                const ac = (a.assetClass || '').toLowerCase();\n                const isSec = (api && typeof api._isSecurity === 'function')\n                    ? api._isSecurity(ac)\n                    : ['stock', 'fund', 'managed_fund', 'pension_fund', 'pension_3a_fund', 'pension_3a_managed'].includes(ac);\n\n                const isLiquid = (api && typeof api._isAssetLiquid === 'function')\n                    ? api._isAssetLiquid(a)\n                    : (['cash', 'account', 'bank'].includes(ac) || a.isLiquid === true);\n\n                if (isLiquid && !isSec) return;\n\n                const histDiv = assetDivMap[a.name] || 0;\n                const yieldPct = parseFloat(a.forwardYield || 0);\n                const curVal = !a.isArchived \n                    ? ((api && typeof api.getLatestBalanceValue === 'function') ? api.getLatestBalanceValue(a) : 0)\n                    : 0;\n\n                if (!incArchived && a.isArchived) return;\n                if (onlyPaying && histDiv <= 0) return;\n\n                if (histDiv > 0 || yieldPct > 0 || isSec) {\n                    if (!a.isArchived) activeCount++;\n                    holdings.push({\n                        name: a.name,\n                        bank: a.bankName || '-',\n                        class: a.assetClass || 'stock',\n                        isArchived: !!a.isArchived,\n                        val: curVal,\n                        divs: histDiv,\n                        yieldPct: yieldPct > 0 ? yieldPct : (curVal > 0 && histDiv > 0 ? (histDiv / curVal) * 100 : 0)\n                    });\n                }\n            });\n\n            holdings.sort((a, b) => b.divs - a.divs || b.val - a.val);\n            cachedHoldings = holdings;\n\n            return { holdings, totalHistDiv, forecast12m, activeCount };\n        }\n\n        function renderTable() {\n            const query = (document.getElementById('assetSearchInput').value || '').toLowerCase();\n            const filtered = cachedHoldings.filter(h => h.name.toLowerCase().includes(query) || h.bank.toLowerCase().includes(query));\n\n            const incArchived = document.getElementById('chkIncludeArchived').checked;\n            const activeCount = cachedHoldings.filter(h => !h.isArchived).length;\n            document.getElementById('lblAssetFilterNotice').innerText = t('countNotice')(filtered.length, activeCount);\n\n            if (filtered.length === 0) {\n                document.getElementById('assetTableBody').innerHTML = `\n                    <tr><td colspan=\"6\" class=\"p-6 text-center text-gray-400 font-sans\">${t('noHoldings')}</td></tr>\n                `;\n                return;\n            }\n\n            document.getElementById('assetTableBody').innerHTML = filtered.map(h => {\n                const yieldStr = h.yieldPct > 0 ? `${h.yieldPct.toFixed(2)}%` : '-';\n                const archiveBadge = h.isArchived \n                    ? `<span class=\"ml-2 px-1.5 py-0.5 rounded text-[9px] font-semibold bg-gray-200 dark:bg-slate-800 text-gray-600 dark:text-gray-400 font-sans\">${t('badgeArchived')}</span>`\n                    : '';\n\n                return `\n                    <tr class=\"hover:bg-gray-50/80 dark:hover:bg-slate-800/40 transition-colors ${h.isArchived ? 'opacity-60 bg-gray-50/50 dark:bg-slate-900/50' : ''}\">\n                        <td class=\"p-3.5 font-sans font-bold text-slate-800 dark:text-slate-200 flex items-center\">\n                            <span>${h.name}</span>\n                            ${archiveBadge}\n                        </td>\n                        <td class=\"p-3.5 text-gray-500 dark:text-gray-400 font-sans\">${h.bank}</td>\n                        <td class=\"p-3.5 uppercase text-gray-500 dark:text-gray-400\">${h.class}</td>\n                        <td class=\"p-3.5 text-right font-black text-slate-900 dark:text-white\">${h.val > 0 ? fmt(h.val) : '-'}</td>\n                        <td class=\"p-3.5 text-right font-bold text-emerald-600 dark:text-emerald-400\">${h.divs > 0 ? fmt(h.divs) : '-'}</td>\n                        <td class=\"p-3.5 text-right font-bold text-blue-600 dark:text-blue-400\">${yieldStr}</td>\n                    </tr>\n                `;\n            }).join('');\n        }\n\n        function run() {\n            const { holdings, totalHistDiv, forecast12m } = extractDataEngineAligned();\n            renderTable();\n\n            // Automatische Synchronisation der Dividendenbasis (ausser der Nutzer hat den Schieberegler manuell bedient)\n            if (!userHasEditedBase) {\n                const optimalBase = forecast12m > 0 ? Math.round(forecast12m) : Math.round(totalHistDiv);\n                document.getElementById('slideBaseAnnual').value = optimalBase > 0 ? optimalBase : 2000;\n                document.getElementById('numBaseAnnual').value = optimalBase > 0 ? optimalBase : 2000;\n            }\n\n            const curAnnualBase = parseFloat(document.getElementById('numBaseAnnual').value) || forecast12m || totalHistDiv || 2000;\n            const grw = parseFloat(document.getElementById('numDivGrowth').value) / 100;\n            const reinvMonthly = parseFloat(document.getElementById('numReinvest').value);\n            const reinvYld = parseFloat(document.getElementById('numReinvestYield').value) / 100;\n            const yrs = parseInt(document.getElementById('numHorizon').value);\n\n            let annualFlow = curAnnualBase;\n            let cumulated = 0;\n            const labels = [], dataMonthly = [], dataCumulated = [];\n            const curYr = new Date().getFullYear();\n\n            for (let i = 0; i <= yrs; i++) {\n                labels.push(String(curYr + i));\n                dataMonthly.push(Math.round(annualFlow / 12));\n                cumulated += annualFlow;\n                dataCumulated.push(Math.round(cumulated));\n                annualFlow = (annualFlow * (1 + grw)) + ((reinvMonthly * 12) * reinvYld);\n            }\n\n            const dblYrs = grw > 0 ? Math.round(72 / (grw * 100)) : 99;\n            const includeInterest = document.getElementById('chkIncludeInterest').checked;\n\n            // FinBundle KPI Dashboard\n            document.getElementById('kpiGrid').innerHTML = `\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-emerald-600 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                        <span>${t('kRec')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-emerald-600 dark:text-emerald-400 truncate font-mono\">${fmt(totalHistDiv)}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${includeInterest ? t('kRecSubAll') : t('kRecSubDividendsOnly')}</div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-blue-600 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-blue-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path></svg>\n                        <span>${t('kCur')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-blue-600 dark:text-blue-400 truncate font-mono\">${fmt(curAnnualBase / 12)}${t('perMonth')}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${fmt(curAnnualBase)} p.a.</div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-amber-500 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-amber-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"></path></svg>\n                        <span>${t('kEnd')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-amber-600 dark:text-amber-400 truncate font-mono\">${fmt(dataMonthly[dataMonthly.length-1])}${t('perMonth')}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${t('inYears')(yrs)}</div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-purple-600 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-purple-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                        <span>${t('kDbl')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-purple-600 dark:text-purple-400 truncate font-mono\">~ ${dblYrs} ${t('yUnit')}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${t('kDblSub')}</div>\n                </div>\n            `;\n\n            // Chart 1: Bar Chart (Monatlicher Cashflow)\n            const ctx1 = document.getElementById('snowballChart').getContext('2d');\n            if (barChart) barChart.destroy();\n            barChart = new Chart(ctx1, {\n                type: 'bar',\n                data: { \n                    labels, \n                    datasets: [{ \n                        label: t('ch1'), \n                        data: dataMonthly, \n                        backgroundColor: '#059669', \n                        borderRadius: 4 \n                    }] \n                },\n                options: { \n                    animation: false, \n                    responsive: true, \n                    maintainAspectRatio: false, \n                    scales: { \n                        x: { grid: { display: false } },\n                        y: { ticks: { callback: v => fmt(v) } } \n                    } \n                }\n            });\n\n            // Chart 2: Akkumulierter Ertrag (Linie)\n            const ctx2 = document.getElementById('accumulatedChart').getContext('2d');\n            if (lineChart) lineChart.destroy();\n            lineChart = new Chart(ctx2, {\n                type: 'line',\n                data: {\n                    labels,\n                    datasets: [{\n                        label: t('ch2'),\n                        data: dataCumulated,\n                        borderColor: '#2563eb',\n                        backgroundColor: 'rgba(37, 99, 235, 0.08)',\n                        fill: true,\n                        tension: 0.2\n                    }]\n                },\n                options: { \n                    animation: false, \n                    responsive: true, \n                    maintainAspectRatio: false,\n                    scales: {\n                        y: { ticks: { callback: v => fmt(v) } }\n                    }\n                }\n            });\n\n            lastRes = { totalHistDiv, curMonthly: curAnnualBase / 12, endMonthly: dataMonthly[dataMonthly.length-1], holdings };\n        }\n\n        document.getElementById('pdfBtn').addEventListener('click', async () => {\n            if (!lastRes) return;\n            await api.exportPdfReport({\n                title: t('title'),\n                subtitle: t('sub'),\n                kpis: [\n                    { label: t('kCur'), value: fmt(lastRes.curMonthly) + t('perMonth'), color: '#2563eb' },\n                    { label: t('kEnd'), value: fmt(lastRes.endMonthly) + t('perMonth'), color: '#059669' }\n                ],\n                chartsData: await api.captureAllCharts(),\n                tableHeaders: [t('thAsName'), t('thAsBank'), t('thAsClass'), t('thAsValue'), t('thAsDiv')],\n                tableBody: lastRes.holdings.map(h => [h.name, h.bank, h.class, fmt(h.val), fmt(h.divs)])\n            });\n        });\n\n        initUI();\n        run();\n    </script>\n</body>\n</html>",
    "isPinned": false,
    "createdAt": "2026-10-04T12:00:00.000Z"
  }
}