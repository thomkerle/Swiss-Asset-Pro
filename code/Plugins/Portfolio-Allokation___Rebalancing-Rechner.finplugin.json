  "exportedAt": "2026-10-04T11:52:37.652Z",
  "plugin": {
    "title": "Portfolio-Allokation & Rebalancing-Rechner",
    "category": "Allokation",
    "code": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <link href=\"https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css\" rel=\"stylesheet\">\n    <style>\n        body { \n            background: #ffffff; \n            font-family: system-ui, -apple-system, sans-serif; \n        }\n        .dark body { background: #020617; }\n        input[type=\"range\"] { \n            -webkit-appearance: none; \n            height: 5px; \n            border-radius: 9999px; \n            background: #e2e8f0; \n            outline: none; \n        }\n        .dark input[type=\"range\"] { background: #334155; }\n        input[type=\"range\"]::-webkit-slider-thumb { \n            -webkit-appearance: none; \n            width: 15px; \n            height: 15px; \n            border-radius: 50%; \n            background: #2563eb; \n            cursor: pointer; \n        }\n    </style>\n</head>\n<body class=\"p-6 md:p-8 max-w-7xl mx-auto bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors\">\n\n    <!-- Report Header Bar -->\n    <div class=\"flex flex-col sm:flex-row justify-between items-start sm:items-center pb-5 mb-6 border-b border-gray-200 dark:border-slate-800 gap-4\">\n        <div>\n            <h2 id=\"repTitle\" class=\"text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3\">\n                <svg class=\"w-7 h-7 text-blue-600 dark:text-blue-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z\"></path>\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z\"></path>\n                </svg>\n                <span id=\"titleText\"></span>\n            </h2>\n            <p id=\"repSub\" class=\"text-sm text-gray-500 dark:text-gray-400 mt-1\"></p>\n        </div>\n        <button id=\"pdfBtn\" class=\"bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-5 rounded-xl shadow-sm text-xs transition-colors flex items-center gap-2 cursor-pointer shrink-0\">\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"></path>\n            </svg>\n            <span id=\"lblPdfBtn\"></span>\n        </button>\n    </div>\n\n    <!-- Erklärungs- & Interpretationsbox -->\n    <div id=\"explBox\" class=\"mb-8 p-5 rounded-2xl bg-blue-50/60 dark:bg-blue-950/20 border border-blue-200/80 dark:border-blue-800/50 text-xs text-blue-950 dark:text-blue-300 leading-relaxed shadow-xs flex items-start gap-3\">\n        <svg class=\"w-5 h-5 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n        </svg>\n        <div id=\"explText\"></div>\n    </div>\n\n    <!-- FinBundle KPI Dashboard Grid -->\n    <div id=\"kpiGrid\" class=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8 p-1\"></div>\n\n    <!-- Hauptbereich: Parameter & Visualisierungen -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8\">\n        \n        <!-- Parameter-Spalte links -->\n        <div class=\"lg:col-span-4 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-5\">\n            <div class=\"flex justify-between items-center pb-3 border-b border-gray-100 dark:border-slate-800\">\n                <h3 id=\"headParam\" class=\"font-bold text-base text-slate-800 dark:text-slate-200 flex items-center gap-2\">\n                    <svg class=\"w-4 h-4 text-blue-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4\"></path>\n                    </svg>\n                    <span id=\"lblParamTitle\"></span>\n                </h3>\n                <span id=\"lblAllocSum\" class=\"text-[10px] bg-blue-100 dark:bg-blue-900/40 text-blue-800 dark:text-blue-300 font-bold px-2.5 py-0.5 rounded-full font-mono\">100%</span>\n            </div>\n\n            <!-- Schutz gebundener Gelder -->\n            <div class=\"p-3.5 bg-gray-50 dark:bg-slate-800/60 rounded-xl border border-gray-200 dark:border-slate-700/60 shadow-xs\">\n                <label class=\"flex items-center gap-2.5 text-xs font-semibold text-slate-800 dark:text-slate-200 cursor-pointer\">\n                    <input type=\"checkbox\" id=\"chkExcludePension\" checked class=\"w-4 h-4 text-blue-600 rounded cursor-pointer\">\n                    <span id=\"lblExcludePension\"></span>\n                </label>\n                <p id=\"lblExcludePensionSub\" class=\"text-[10px] text-gray-500 dark:text-gray-400 mt-1 pl-6.5 leading-tight\"></p>\n            </div>\n\n            <!-- Ziel-Allokationsschieber -->\n            <div class=\"space-y-3.5\">\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblStockHead\" class=\"font-medium text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numStock\" value=\"70\" min=\"0\" max=\"100\" step=\"5\" class=\"w-20 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-blue-600 dark:text-blue-400\">\n                    </div>\n                    <input id=\"slideStock\" type=\"range\" min=\"0\" max=\"100\" step=\"5\" value=\"70\" class=\"w-full\">\n                </div>\n\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblCashHead\" class=\"font-medium text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numCash\" value=\"20\" min=\"0\" max=\"100\" step=\"5\" class=\"w-20 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-emerald-600 dark:text-emerald-400\">\n                    </div>\n                    <input id=\"slideCash\" type=\"range\" min=\"0\" max=\"100\" step=\"5\" value=\"20\" class=\"w-full\">\n                </div>\n\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblCryptoHead\" class=\"font-medium text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numCrypto\" value=\"10\" min=\"0\" max=\"100\" step=\"5\" class=\"w-20 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-amber-600 dark:text-amber-400\">\n                    </div>\n                    <input id=\"slideCrypto\" type=\"range\" min=\"0\" max=\"100\" step=\"5\" value=\"10\" class=\"w-full\">\n                </div>\n            </div>\n\n            <!-- Zusätzliches Frischegeld / Sparplan -->\n            <div class=\"pt-3 border-t border-gray-100 dark:border-slate-800 space-y-2\">\n                <div class=\"flex justify-between items-center text-xs mb-1\">\n                    <span id=\"lblFreshMoneyHead\" class=\"font-medium text-gray-700 dark:text-gray-300\"></span>\n                    <input type=\"number\" id=\"numFreshMoney\" value=\"0\" min=\"0\" max=\"100000\" step=\"500\" class=\"w-24 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200\">\n                </div>\n                <input id=\"slideFreshMoney\" type=\"range\" min=\"0\" max=\"50000\" step=\"500\" value=\"0\" class=\"w-full\">\n                <p id=\"lblFreshMoneySub\" class=\"text-[10px] text-gray-400\"></p>\n            </div>\n        </div>\n\n        <!-- Rechte Seite: Charts & Tabelle -->\n        <div class=\"lg:col-span-8 flex flex-col gap-6\">\n            <div class=\"grid grid-cols-1 xl:grid-cols-2 gap-6\">\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm\">\n                    <h3 id=\"headIstChart\" class=\"font-bold text-base mb-4 flex items-center gap-2 text-slate-800 dark:text-slate-200\">\n                        <svg class=\"w-4 h-4 text-blue-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z\"></path></svg>\n                        <span id=\"lblIstChartTitle\"></span>\n                    </h3>\n                    <div style=\"height: 220px;\"><canvas id=\"chartIst\"></canvas></div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm\">\n                    <h3 id=\"headSollChart\" class=\"font-bold text-base mb-4 flex items-center gap-2 text-slate-800 dark:text-slate-200\">\n                        <svg class=\"w-4 h-4 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                        <span id=\"lblSollChartTitle\"></span>\n                    </h3>\n                    <div style=\"height: 220px;\"><canvas id=\"chartSoll\"></canvas></div>\n                </div>\n            </div>\n\n            <!-- Detailtabelle -->\n            <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden\">\n                <div class=\"p-5 border-b border-gray-100 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-800/30 flex justify-between items-center\">\n                    <h3 class=\"font-bold text-base text-slate-800 dark:text-slate-200 flex items-center gap-2\" id=\"headMatrix\">\n                        <svg class=\"w-4 h-4 text-slate-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2\"></path></svg>\n                        <span id=\"lblTableTitle\"></span>\n                    </h3>\n                    <span id=\"lblAssetCountBadge\" class=\"text-xs text-gray-500 font-medium font-mono\"></span>\n                </div>\n                <div class=\"overflow-x-auto max-h-60 overflow-y-auto\">\n                    <table class=\"w-full text-left text-sm font-mono\">\n                        <thead class=\"bg-white dark:bg-slate-900 text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-slate-800 text-xs uppercase font-bold sticky top-0 z-10 shadow-sm\">\n                            <tr>\n                                <th class=\"p-3.5 font-sans\" id=\"thClass\"></th>\n                                <th class=\"p-3.5 text-right\" id=\"thIstVal\"></th>\n                                <th class=\"p-3.5 text-right\" id=\"thIstPct\"></th>\n                                <th class=\"p-3.5 text-right\" id=\"thSollPct\"></th>\n                                <th class=\"p-3.5 text-right\" id=\"thAction\"></th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"rebalanceBody\" class=\"divide-y divide-gray-100 dark:divide-slate-800 text-xs\"></tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <script>\n        if (window.parent && window.parent.document.documentElement.classList.contains('dark')) {\n            document.documentElement.classList.add('dark');\n        }\n\n        const api = window.FinSPA_API;\n        const LANG = (api && api.getLanguage && api.getLanguage()) || 'de';\n\n        const I18N = {\n            de: {\n                title: 'Portfolio-Allokation & Rebalancing-Rechner',\n                sub: 'Drift-Erkennung und Generierung gezielter Kauf- und Verkaufsaufträge',\n                exp: 'Bericht exportieren (PDF)',\n                expl: '<strong>Wozu dient dieser Report?</strong> Gesetzlich gebundene Vorsorge (Pensionskasse BVG, Säule 3a) kann im regulären Alltag nicht liquidiert oder verkauft werden. Dieser Report schliesst gebundene Gelder auf Wunsch aus und berechnet Rebalancing-Aufträge <em>ausschliesslich auf Ihrem frei verfügbaren Anlagevermögen</em> (Aktien, ETFs, Cash, Krypto). Sie können auch Frischegeld einbeziehen, um steuer- und gebührenschonend durch Zukäufe zu rebalancen.',\n                p: 'Rebalancing-Parameter',\n                exPen: 'Gebundene Vorsorge (2. & 3a) ausschliessen (Empfohlen)',\n                exPenSub: 'Verhindert unlogische Verkaufsaufträge auf Pensionskasse und Säule 3a',\n                stk: 'Aktien / Fonds / ETFs (%)',\n                csh: 'Liquidität / Sparkonten (%)',\n                cry: 'Krypto / Alternative (%)',\n                fresh: 'Zusätzliches Frischegeld / Sparplan',\n                freshSub: 'Ermöglicht Buy-Only Rebalancing ohne Vermögensverkäufe',\n                distIst: 'Ist-Allokation (Frei)',\n                distSoll: 'Soll-Allokation (Ziel)',\n                matrix: 'Empfohlene Rebalancing-Aufträge',\n                buy: 'Kauf',\n                sell: 'Verkauf',\n                thClass: 'Kategorie',\n                thIstVal: 'Ist (CHF)',\n                thIstPct: 'Ist %',\n                thSollPct: 'Ziel %',\n                thAction: 'Empfohlene Order',\n                kFree: 'Freies Anlagekapital',\n                kFreeSubEx: 'Reines Handelsdepot & Cash',\n                kFreeSubAll: 'Gesamtvermögen inkl. Vorsorge',\n                kStk: 'Aktienquote',\n                kCsh: 'Cash-Quote',\n                kReb: 'Umschichtungsvolumen',\n                kRebSub: 'Rebalancing-Bedarf',\n                targetPrefix: 'Ziel: ',\n                catCount: 'Kategorien',\n                lockedPen: 'Gebundene Vorsorge (Gesperrt)',\n                pdfSubEx: 'Ohne gebundene Vorsorge',\n                pdfSubAll: 'Gesamtes Portfolio',\n                pdfGroup: 'Allokationsvorgaben'\n            },\n            en: {\n                title: 'Portfolio Allocation & Rebalancing Tool',\n                sub: 'Drift detection and targeted order calculation on liquid assets',\n                exp: 'Export Report (PDF)',\n                expl: '<strong>Purpose:</strong> Occupational pension funds (2nd pillar) and locked Pillar 3a assets cannot be sold or liquidated on demand. This report excludes locked pension assets by default and models rebalancing trades <em>exclusively for liquid portfolios</em> (Equities, ETFs, Cash, Crypto). Also supports fresh capital injection to rebalance with buy-only orders.',\n                p: 'Rebalancing Parameters',\n                exPen: 'Exclude locked pension (2nd & 3a) (Recommended)',\n                exPenSub: 'Avoids non-executable sell orders for pension fund and Pillar 3a assets',\n                stk: 'Equities & ETFs (%)',\n                csh: 'Cash & Savings (%)',\n                cry: 'Crypto & Alternatives (%)',\n                fresh: 'Fresh Capital / Contribution',\n                freshSub: 'Allows cashflow rebalancing without selling assets',\n                distIst: 'Current Allocation (Liquid)',\n                distSoll: 'Target Allocation (Goal)',\n                matrix: 'Rebalancing Order Schedule',\n                buy: 'Buy',\n                sell: 'Sell',\n                thClass: 'Category',\n                thIstVal: 'Current (CHF)',\n                thIstPct: 'Current %',\n                thSollPct: 'Target %',\n                thAction: 'Trade Order',\n                kFree: 'Liquid Capital',\n                kFreeSubEx: 'Pure Trading Portfolio & Cash',\n                kFreeSubAll: 'Total Wealth incl. Pension',\n                kStk: 'Equity Ratio',\n                kCsh: 'Cash Ratio',\n                kReb: 'Rebalance Turnover',\n                kRebSub: 'Rebalance Requirement',\n                targetPrefix: 'Target: ',\n                catCount: 'Categories',\n                lockedPen: 'Locked Pension (Restricted)',\n                pdfSubEx: 'Excl. locked pension',\n                pdfSubAll: 'Total Portfolio',\n                pdfGroup: 'Allocation Targets'\n            },\n            fr: {\n                title: 'Allocation de portefeuille & Rééquilibrage',\n                sub: 'Calcul des ordres de rééquilibrage sur les actifs disponibles',\n                exp: 'Exporter en PDF',\n                expl: '<strong>Objectif:</strong> La prévoyance liée (LPP, 3a) ne peut pas être vendue librement. Ce rapport exclut la prévoyance bloquée pour calculer les rééquilibrages <em>uniquement sur vos actifs liquides négociables</em> (actions, ETF, liquidités, crypto). Vous pouvez également simuler des apports d\\'argent frais pour rééquilibrer par de simples achats.',\n                p: 'Paramètres',\n                exPen: 'Exclure la prévoyance liée (LPP & 3a) (Recommandé)',\n                exPenSub: 'Évite les ordres de vente impossibles sur la LPP et le 3a',\n                stk: 'Actions & ETF (%)',\n                csh: 'Liquidités (%)',\n                cry: 'Crypto & Alternatifs (%)',\n                fresh: 'Apport de capital frais',\n                freshSub: 'Permet un rééquilibrage par achats uniquement',\n                distIst: 'Allocation actuelle (Libre)',\n                distSoll: 'Allocation cible',\n                matrix: 'Ordres d\\'équilibrage recommandés',\n                buy: 'Achat',\n                sell: 'Vente',\n                thClass: 'Catégorie',\n                thIstVal: 'Actuel (CHF)',\n                thIstPct: 'Actuel %',\n                thSollPct: 'Cible %',\n                thAction: 'Ordre',\n                kFree: 'Capital libre',\n                kFreeSubEx: 'Portefeuille libre & liquidités',\n                kFreeSubAll: 'Patrimoine total avec prévoyance',\n                kStk: 'Part Actions',\n                kCsh: 'Part Cash',\n                kReb: 'Volume à rééquilibrer',\n                kRebSub: 'Besoin de rééquilibrage',\n                targetPrefix: 'Cible: ',\n                catCount: 'Catégories',\n                lockedPen: 'Prévoyance liée (Bloquée)',\n                pdfSubEx: 'Sans prévoyance liée',\n                pdfSubAll: 'Portefeuille global',\n                pdfGroup: 'Objectifs d\\'allocation'\n            },\n            it: {\n                title: 'Allocazione del portafoglio & Ribilanciamento',\n                sub: 'Calcolo degli ordini di riequilibrio sulle attività libere',\n                exp: 'Esporta in PDF',\n                expl: '<strong>Finalità:</strong> La previdenza vincolata (LPP, 3a) non può essere venduta liberamente. Questo report esclude i fondi bloccati e concentra il ribilanciamento <em>esclusivamente sul patrimonio liquido negoziabile</em> (azioni, ETF, liquidità, crypto). Permette inoltre di simulare nuova liquidità per ribilanciare senza vendere.',\n                p: 'Parametri',\n                exPen: 'Escludi previdenza vincolata (LPP & 3a) (Consigliato)',\n                exPenSub: 'Evita ordini di vendita impossibili sulla cassa pensione e 3a',\n                stk: 'Azioni & ETF (%)',\n                csh: 'Liquidità (%)',\n                cry: 'Crypto & Altro (%)',\n                fresh: 'Nuova liquidità / Risparmio',\n                freshSub: 'Permette di ribilanciare solo con acquisti',\n                distIst: 'Allocazione attuale',\n                distSoll: 'Allocazione obiettivo',\n                matrix: 'Ordini di ribilanciamento',\n                buy: 'Compra',\n                sell: 'Vendi',\n                thClass: 'Categoria',\n                thIstVal: 'Attuale (CHF)',\n                thIstPct: 'Attuale %',\n                thSollPct: 'Obiettivo %',\n                thAction: 'Azione',\n                kFree: 'Patrimonio libero',\n                kFreeSubEx: 'Portafoglio libero e liquidità',\n                kFreeSubAll: 'Patrimonio totale inclusa previdenza',\n                kStk: 'Quota Azioni',\n                kCsh: 'Quota Liquidità',\n                kReb: 'Volume ribilanciamento',\n                kRebSub: 'Fabbisogno di riallineamento',\n                targetPrefix: 'Obiettivo: ',\n                catCount: 'Categorie',\n                lockedPen: 'Previdenza vincolata (Bloccata)',\n                pdfSubEx: 'Esclusa previdenza vincolata',\n                pdfSubAll: 'Portafoglio complessivo',\n                pdfGroup: 'Parametri di allocazione'\n            }\n        };\n\n        const t = (k) => (I18N[LANG] && I18N[LANG][k]) || I18N['de'][k] || k;\n        let chart1 = null, chart2 = null, lastRes = null;\n\n        function fmt(v) { return api ? api.formatCurrency(v) : 'CHF ' + Math.round(v).toLocaleString('de-CH'); }\n\n        function syncPair(slideId, numId, cb) {\n            const s = document.getElementById(slideId), n = document.getElementById(numId);\n            s.addEventListener('input', () => { n.value = s.value; cb(); });\n            n.addEventListener('input', () => { s.value = n.value; cb(); });\n        }\n\n        function initUI() {\n            document.getElementById('titleText').innerText = t('title');\n            document.getElementById('repSub').innerText = t('sub');\n            document.getElementById('lblPdfBtn').innerText = t('exp');\n            document.getElementById('explText').innerHTML = t('expl');\n            document.getElementById('lblParamTitle').innerText = t('p');\n            document.getElementById('lblExcludePension').innerText = t('exPen');\n            document.getElementById('lblExcludePensionSub').innerText = t('exPenSub');\n            document.getElementById('lblStockHead').innerText = t('stk');\n            document.getElementById('lblCashHead').innerText = t('csh');\n            document.getElementById('lblCryptoHead').innerText = t('cry');\n            document.getElementById('lblFreshMoneyHead').innerText = t('fresh');\n            document.getElementById('lblFreshMoneySub').innerText = t('freshSub');\n            document.getElementById('lblIstChartTitle').innerText = t('distIst');\n            document.getElementById('lblSollChartTitle').innerText = t('distSoll');\n            document.getElementById('lblTableTitle').innerText = t('matrix');\n            document.getElementById('thClass').innerText = t('thClass');\n            document.getElementById('thIstVal').innerText = t('thIstVal');\n            document.getElementById('thIstPct').innerText = t('thIstPct');\n            document.getElementById('thSollPct').innerText = t('thSollPct');\n            document.getElementById('thAction').innerText = t('thAction');\n\n            syncPair('slideStock', 'numStock', run);\n            syncPair('slideCash', 'numCash', run);\n            syncPair('slideCrypto', 'numCrypto', run);\n            syncPair('slideFreshMoney', 'numFreshMoney', run);\n            document.getElementById('chkExcludePension').addEventListener('change', run);\n        }\n\n        function run() {\n            const exPen = document.getElementById('chkExcludePension').checked;\n            const freshMoney = parseFloat(document.getElementById('numFreshMoney').value) || 0;\n            const assets = api ? api.getAllAssets() : [];\n\n            let valStock = 0, valCash = 0, valCrypto = 0, valPension = 0;\n\n            assets.forEach(a => {\n                const ac = (a.assetClass||'').toLowerCase();\n                const val = api ? api.getLatestBalanceValue(a) : 0;\n                if (ac.includes('3a') || ac.includes('pension')) { \n                    valPension += val; \n                } else if (['stock', 'fund', 'managed_fund'].includes(ac)) { \n                    valStock += val; \n                } else if (['cash', 'account'].includes(ac) || (api && typeof api._isAssetLiquid === 'function' && api._isAssetLiquid(a))) { \n                    valCash += val; \n                } else if (ac.includes('crypto')) { \n                    valCrypto += val; \n                } else { \n                    valCash += val; \n                }\n            });\n\n            if (valStock === 0 && valCash === 0 && valCrypto === 0) { \n                valStock = 60000; valCash = 30000; valCrypto = 10000; \n            }\n\n            const currentLiquidTotal = valStock + valCash + valCrypto;\n            const totalInvestable = currentLiquidTotal + freshMoney + (!exPen ? valPension : 0);\n\n            const sStock = parseFloat(document.getElementById('numStock').value) || 0;\n            const sCash = parseFloat(document.getElementById('numCash').value) || 0;\n            const sCrypto = parseFloat(document.getElementById('numCrypto').value) || 0;\n            const sumSoll = sStock + sCash + sCrypto || 1;\n\n            document.getElementById('lblAllocSum').innerText = `${sumSoll.toFixed(0)}%`;\n\n            const normStock = (sStock / sumSoll) * 100;\n            const normCash = (sCash / sumSoll) * 100;\n            const normCrypto = (sCrypto / sumSoll) * 100;\n\n            const items = [\n                { name: t('stk'), ist: valStock, sollPct: normStock, col: '#2563eb' },\n                { name: t('csh'), ist: valCash + freshMoney, sollPct: normCash, col: '#059669' },\n                { name: t('cry'), ist: valCrypto, sollPct: normCrypto, col: '#f59e0b' }\n            ];\n\n            if (!exPen && valPension > 0) {\n                items.push({ name: t('lockedPen'), ist: valPension, sollPct: 0, col: '#8b5cf6' });\n            }\n\n            let totalRebVolume = 0;\n            const tableRows = items.map(it => {\n                const istPct = (it.ist / totalInvestable) * 100;\n                const sollVal = (it.sollPct / 100) * totalInvestable;\n                const diff = sollVal - it.ist;\n                if (diff > 0) totalRebVolume += diff;\n                const actStr = diff >= 0 ? `+${fmt(diff)} (${t('buy')})` : `${fmt(diff)} (${t('sell')})`;\n                return { ...it, istPct, sollVal, diff, actStr };\n            });\n\n            // FinBundle KPI Dashboard - Vollsynthetisch übersetzt\n            document.getElementById('kpiGrid').innerHTML = `\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-blue-500 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-blue-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                        <span>${t('kFree')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-slate-900 dark:text-white truncate font-mono\">${fmt(totalInvestable)}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${exPen ? t('kFreeSubEx') : t('kFreeSubAll')}</div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-indigo-500 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-indigo-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path></svg>\n                        <span>${t('kStk')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-indigo-600 dark:text-indigo-400 truncate font-mono\">${((valStock / totalInvestable)*100).toFixed(1)} %</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${t('targetPrefix')}${normStock.toFixed(0)}%</div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-emerald-500 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z\"></path></svg>\n                        <span>${t('kCsh')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-emerald-600 dark:text-emerald-400 truncate font-mono\">${(((valCash + freshMoney) / totalInvestable)*100).toFixed(1)} %</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${t('targetPrefix')}${normCash.toFixed(0)}%</div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-amber-500 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-amber-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.038 8.038 0 01-15.357-2m15.357 2H15\"></path></svg>\n                        <span>${t('kReb')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-amber-600 dark:text-amber-400 truncate font-mono\">${fmt(totalRebVolume)}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${t('kRebSub')}</div>\n                </div>\n            `;\n\n            document.getElementById('lblAssetCountBadge').innerText = `${items.length} ${t('catCount')}`;\n\n            document.getElementById('rebalanceBody').innerHTML = tableRows.map(r => `\n                <tr class=\"hover:bg-gray-50/80 dark:hover:bg-slate-800/40 transition-colors\">\n                    <td class=\"p-3.5 font-sans font-semibold flex items-center gap-2 text-slate-800 dark:text-slate-200\">\n                        <span class=\"w-2.5 h-2.5 rounded-full shrink-0\" style=\"background:${r.col}\"></span>\n                        <span>${r.name}</span>\n                    </td>\n                    <td class=\"p-3.5 text-right font-bold text-slate-900 dark:text-white\">${fmt(r.ist)}</td>\n                    <td class=\"p-3.5 text-right text-gray-500 dark:text-gray-400\">${r.istPct.toFixed(1)}%</td>\n                    <td class=\"p-3.5 text-right font-bold text-slate-700 dark:text-slate-300\">${r.sollPct.toFixed(1)}%</td>\n                    <td class=\"p-3.5 text-right font-bold ${r.diff >= 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-rose-600 dark:text-rose-400'}\">${r.actStr}</td>\n                </tr>\n            `).join('');\n\n            // Chart 1: Ist-Verteilung\n            const ctx1 = document.getElementById('chartIst').getContext('2d');\n            if (chart1) chart1.destroy();\n            chart1 = new Chart(ctx1, {\n                type: 'doughnut',\n                data: { \n                    labels: items.map(i => i.name), \n                    datasets: [{ \n                        data: items.map(i => Math.round(i.ist)), \n                        backgroundColor: items.map(i => i.col) \n                    }] \n                },\n                options: { animation: false, responsive: true, maintainAspectRatio: false }\n            });\n\n            // Chart 2: Soll-Verteilung\n            const ctx2 = document.getElementById('chartSoll').getContext('2d');\n            if (chart2) chart2.destroy();\n            chart2 = new Chart(ctx2, {\n                type: 'doughnut',\n                data: { \n                    labels: items.map(i => i.name), \n                    datasets: [{ \n                        data: items.map(i => Math.round((i.sollPct/100)*totalInvestable)), \n                        backgroundColor: items.map(i => i.col) \n                    }] \n                },\n                options: { animation: false, responsive: true, maintainAspectRatio: false }\n            });\n\n            lastRes = { totalInvestable, totalRebVolume, tableRows, exPen, freshMoney };\n        }\n\n        document.getElementById('pdfBtn').addEventListener('click', async () => {\n            if (!lastRes) return;\n            await api.exportPdfReport({\n                title: t('title'),\n                subtitle: `${t('sub')} (${lastRes.exPen ? t('pdfSubEx') : t('pdfSubAll')})`,\n                kpis: [\n                    { label: t('kFree'), value: fmt(lastRes.totalInvestable), color: '#2563eb' },\n                    { label: t('kReb'), value: fmt(lastRes.totalRebVolume), color: '#d97706' }\n                ],\n                parameters: [\n                    {\n                        group: t('pdfGroup'),\n                        items: [\n                            { label: t('stk'), value: document.getElementById('numStock').value + '%' },\n                            { label: t('csh'), value: document.getElementById('numCash').value + '%' },\n                            { label: t('cry'), value: document.getElementById('numCrypto').value + '%' },\n                            { label: t('fresh'), value: fmt(lastRes.freshMoney) }\n                        ]\n                    }\n                ],\n                chartsData: await api.captureAllCharts(),\n                tableHeaders: [t('thClass'), t('thIstVal'), t('thIstPct'), t('thSollPct'), t('thAction')],\n                tableBody: lastRes.tableRows.map(r => [r.name, fmt(r.ist), r.istPct.toFixed(1)+'%', r.sollPct.toFixed(1)+'%', r.actStr])\n            });\n        });\n\n        initUI();\n        run();\n    </script>\n</body>\n</html>",
