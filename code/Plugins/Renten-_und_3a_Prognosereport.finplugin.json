    "code": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <link href=\"https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css\" rel=\"stylesheet\">\n    <style>\n        body { \n            background: #ffffff; \n            font-family: system-ui, -apple-system, sans-serif; \n        }\n        .dark body { background: #020617; }\n        input[type=\"range\"] { \n            -webkit-appearance: none; \n            height: 5px; \n            border-radius: 9999px; \n            background: #e2e8f0; \n            outline: none; \n        }\n        .dark input[type=\"range\"] { background: #334155; }\n        input[type=\"range\"]::-webkit-slider-thumb { \n            -webkit-appearance: none; \n            width: 15px; \n            height: 15px; \n            border-radius: 50%; \n            cursor: pointer; \n        }\n        .slider-3a::-webkit-slider-thumb { background: #059669; }\n        .slider-bvg::-webkit-slider-thumb { background: #2563eb; }\n    </style>\n</head>\n<body class=\"p-6 md:p-8 max-w-7xl mx-auto bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors\">\n\n    <!-- Report Header Bar -->\n    <div class=\"flex flex-col sm:flex-row justify-between items-start sm:items-center pb-5 mb-6 border-b border-gray-200 dark:border-slate-800 gap-4\">\n        <div>\n            <h2 id=\"repTitle\" class=\"text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight flex items-center gap-3\">\n                <svg class=\"w-7 h-7 text-emerald-600 dark:text-emerald-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                </svg>\n                <span id=\"titleText\"></span>\n            </h2>\n            <p id=\"repSub\" class=\"text-sm text-gray-500 dark:text-gray-400 mt-1\"></p>\n        </div>\n        <button id=\"pdfBtn\" class=\"bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-5 rounded-xl shadow-sm text-xs transition-colors flex items-center gap-2 cursor-pointer shrink-0\">\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z\"></path>\n            </svg>\n            <span id=\"lblPdfBtn\"></span>\n        </button>\n    </div>\n\n    <!-- Erklärungs- & Interpretationsbox -->\n    <div id=\"explBox\" class=\"mb-8 p-5 rounded-2xl bg-blue-50/60 dark:bg-blue-950/20 border border-blue-200/80 dark:border-blue-800/50 text-xs text-blue-950 dark:text-blue-300 leading-relaxed shadow-xs flex items-start gap-3\">\n        <svg class=\"w-5 h-5 text-blue-600 dark:text-blue-400 shrink-0 mt-0.5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n            <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n        </svg>\n        <div id=\"explText\"></div>\n    </div>\n\n    <!-- FinBundle KPI Dashboard Grid (4 Spalten mit border-b-4) -->\n    <div id=\"kpiGrid\" class=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-8 p-1\"></div>\n\n    <!-- Hauptbereich: Parameter & Visualisierungen -->\n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 mb-8\">\n        \n        <!-- Parameter-Spalte links -->\n        <div class=\"lg:col-span-4 bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm space-y-5\">\n            <d