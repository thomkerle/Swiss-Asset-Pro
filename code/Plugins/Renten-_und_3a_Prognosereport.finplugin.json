mal text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numSavings3a\" value=\"605\" step=\"10\" class=\"w-24 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-emerald-600 dark:text-emerald-400\">\n                    </div>\n                    <input id=\"slideSavings3a\" type=\"range\" min=\"0\" max=\"750\" step=\"25\" value=\"605\" class=\"w-full slider-3a\">\n                    <!-- Teilbetrags-Pills -->\n                    <div class=\"flex items-center gap-1.5 mt-2\">\n                        <span id=\"lblRatioPrefix\" class=\"text-[10px] text-gray-400 font-normal mr-0.5\"></span>\n                        <button type=\"button\" onclick=\"set3aSavingsRatio(0.5)\" class=\"px-2 py-0.5 rounded text-[10px] font-normal bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-colors\">50%</button>\n                        <button type=\"button\" onclick=\"set3aSavingsRatio(0.75)\" class=\"px-2 py-0.5 rounded text-[10px] font-normal bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-colors\">75%</button>\n                        <button type=\"button\" onclick=\"set3aSavingsRatio(1.0)\" class=\"px-2 py-0.5 rounded text-[10px] font-normal bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/60 transition-colors\" id=\"btnRatioMax\">Max (100%)</button>\n                    </div>\n                </div>\n\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lbl3aRateHead\" class=\"font-normal text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numRate3a\" value=\"4.0\" step=\"0.1\" class=\"w-20 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-emerald-600 dark:text-emerald-400\">\n                    </div>\n                    <input id=\"slideRate3a\" type=\"range\" min=\"0\" max=\"8\" step=\"0.2\" value=\"4.0\" class=\"w-full slider-3a\">\n                </div>\n            </div>\n\n            <!-- BVG Parameter -->\n            <div class=\"pt-3 border-t border-gray-100 dark:border-slate-800 space-y-3.5\">\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblPkMonthHead\" class=\"font-normal text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numSavingsPK\" value=\"800\" step=\"50\" class=\"w-24 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-blue-600 dark:text-blue-400\">\n                    </div>\n                    <input id=\"slideSavingsPK\" type=\"range\" min=\"0\" max=\"3000\" step=\"50\" value=\"800\" class=\"w-full slider-bvg\">\n                </div>\n\n                <div>\n                    <div class=\"flex justify-between items-center text-xs mb-1.5\">\n                        <span id=\"lblPkRateHead\" class=\"font-normal text-gray-700 dark:text-gray-300\"></span>\n                        <input type=\"number\" id=\"numRatePK\" value=\"1.5\" step=\"0.1\" class=\"w-20 p-1.5 text-right text-xs font-mono font-normal border border-gray-200 dark:border-slate-700 rounded-lg bg-gray-50 dark:bg-slate-800 text-blue-600 dark:text-blue-400\">\n                    </div>\n                    <input id=\"slideRatePK\" type=\"range\" min=\"0.5\" max=\"5\" step=\"0.1\" value=\"1.5\" class=\"w-full slider-bvg\">\n                </div>\n            </div>\n        </div>\n\n        <!-- Rechte Seite: Charts & Tabelle -->\n        <div class=\"lg:col-span-8 flex flex-col gap-6\">\n            <div class=\"grid grid-cols-1 xl:grid-cols-2 gap-6\">\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm\">\n                    <h3 id=\"chartHead\" class=\"font-bold text-base mb-4 flex items-center gap-2 text-slate-800 dark:text-slate-200\">\n                        <svg class=\"w-4 h-4 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z\"></path></svg>\n                        <span id=\"lblChart1Title\"></span>\n                    </h3>\n                    <div style=\"height: 250px; width: 100%;\"><canvas id=\"forecastChart\"></canvas></div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl p-6 shadow-sm\">\n                    <h3 id=\"chartCompHead\" class=\"font-bold text-base mb-4 flex items-center gap-2 text-slate-800 dark:text-slate-200\">\n                        <svg class=\"w-4 h-4 text-blue-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z\"></path><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z\"></path></svg>\n                        <span id=\"lblChart2Title\"></span>\n                    </h3>\n                    <div style=\"height: 250px; width: 100%;\"><canvas id=\"compositionChart\"></canvas></div>\n                </div>\n            </div>\n\n            <!-- Detailtabelle -->\n            <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden\">\n                <div class=\"p-5 border-b border-gray-100 dark:border-slate-800 bg-gray-50/50 dark:bg-slate-800/30 flex justify-between items-center\">\n                    <h3 class=\"font-bold text-base text-slate-800 dark:text-slate-200 flex items-center gap-2\" id=\"tableHead\">\n                        <svg class=\"w-4 h-4 text-slate-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\"></path></svg>\n                        <span id=\"lblTableTitle\"></span>\n                    </h3>\n                    <span id=\"lblRowCountBadge\" class=\"text-xs text-gray-500 font-medium font-mono\"></span>\n                </div>\n                <div class=\"overflow-x-auto max-h-60 overflow-y-auto\">\n                    <table class=\"w-full text-left text-sm\">\n                        <thead class=\"bg-white dark:bg-slate-900 text-gray-500 dark:text-gray-400 border-b border-gray-200 dark:border-slate-800 text-xs uppercase font-bold sticky top-0 z-10 shadow-sm\">\n                            <tr>\n                                <th class=\"p-3.5\" id=\"thYr\"></th>\n                                <th class=\"p-3.5\" id=\"thAge\"></th>\n                                <th class=\"p-3.5 text-right\" id=\"th3a\"></th>\n                                <th class=\"p-3.5 text-right\" id=\"thPk\"></th>\n                                <th class=\"p-3.5 text-right\" id=\"thTot\"></th>\n                                <th class=\"p-3.5 text-right\" id=\"thGrw\"></th>\n                            </tr>\n                        </thead>\n                        <tbody id=\"tableBody\" class=\"divide-y divide-gray-100 dark:divide-slate-800 font-mono text-xs\"></tbody>\n                    </table>\n                </div>\n            </div>\n        </div>\n\n    </div>\n\n    <script>\n        if (window.parent && window.parent.document.documentElement.classList.contains('dark')) {\n            document.documentElement.classList.add('dark');\n        }\n\n        const api = window.FinSPA_API;\n        const LANG = (api && api.getLanguage && api.getLanguage()) || 'de';\n\n        const I18N = {\n            de: {\n                title: 'Renten- und 3a Prognosereport',\n                sub: 'Getrennte Hochrechnung von Säule 3a und Pensionskasse bis zum Pensionsalter',\n                exp: 'Bericht exportieren (PDF)',\n                expl: '<strong>Wozu dient dieser Report?</strong> Er trennt strikt zwischen der Säule 3a (steuerbegünstigtes Sparen mit individuellem Renditepotenzial) und der 2. Säule (BVG-Pensionskasse). Sie können gesetzliche Erhöhungen des 3a-Höchstabzugs simulieren und ermitteln, wie hoch der Zinseszins-Anteil an Ihrem künftigen Altersguthaben sein wird. Berücksichtigt auch Teilzeit- und Teilsparquoten.',\n                p: 'Modellparameter',\n                birth: 'Geburtsdatum',\n                retAge: 'Pensionsalter',\n                m3aMax: 'Gesetzl. 3a Höchstbetrag p.a.',\n                m3aMonth: 'Monatl. 3a Sparrate',\n                r3a: 'Rendite 3a p.a. (%)',\n                mPk: 'BVG Sparbeitrag / Mt.',\n                rPk: 'BVG-Verzinsung p.a. (%)',\n                ch: 'Vermögensentwicklung bis zur Pensionierung',\n                chComp: 'Endkapital-Zusammensetzung',\n                tbl: 'Jahresverlauf Projektion',\n                kStart: 'Startkapital',\n                kStartSub: '3a + BVG Bestand',\n                kDep: 'Eigene Sparbeiträge',\n                kInt: 'Erwirtschafteter Zins',\n                kIntSub: 'Zinseszins gesamt',\n                kEnd: 'Endguthaben (Ziel)',\n                kEndSub: 'Prognose per Alter',\n                ratioPrefix: 'Quote:',\n                perMonth: '/Mt.',\n                yUnit: 'Jahre',\n                ageP: 'Alter',\n                thYr: 'Jahr',\n                thAge: 'Alter',\n                th3a: 'Säule 3a',\n                thPk: 'Pensionskasse',\n                thTot: 'Gesamtkapital',\n                thGrw: 'Zuwachs p.a.',\n                pCur: 'Aktuell (7\\'258)',\n                pHike: 'Erhöhung (7\\'500)',\n                pFut: 'Zukunft (8\\'000)'\n            },\n            en: {\n                title: 'Pension & 3a Forecast Report',\n                sub: 'Separate projection of Pillar 3a and Occupational Pension until retirement',\n                exp: 'Export Report (PDF)',\n                expl: '<strong>Purpose:</strong> Separates private Pillar 3a assets from 2nd pillar occupational pension funds. Allows testing statutory contribution limit adjustments and projects compound interest leverage over time. Supports partial and flexible savings quotas.',\n                p: 'Parameters',\n                birth: 'Birthdate',\n                retAge: 'Retirement Age',\n                m3aMax: 'Annual Max 3a Limit',\n                m3aMonth: 'Monthly 3a Deposit',\n                r3a: 'Return 3a p.a. (%)',\n                mPk: 'Pension Fund / Month',\n                rPk: 'Pension Interest p.a. (%)',\n                ch: 'Wealth Accumulation Until Retirement',\n                chComp: 'Final Capital Composition',\n                tbl: 'Annual Projection Breakdown',\n                kStart: 'Initial Capital',\n                kStartSub: '3a + BVG Balance',\n                kDep: 'Own Contributions',\n                kInt: 'Compound Return',\n                kIntSub: 'Total compound interest',\n                kEnd: 'Final Balance (Target)',\n                kEndSub: 'Projected at Age',\n                ratioPrefix: 'Quota:',\n                perMonth: '/Mo',\n                yUnit: 'Years',\n                ageP: 'Age',\n                thYr: 'Year',\n                thAge: 'Age',\n                th3a: 'Pillar 3a',\n                thPk: 'Pension Fund',\n                thTot: 'Total Capital',\n                thGrw: 'Growth p.a.',\n                pCur: 'Current (7,258)',\n                pHike: 'Increase (7,500)',\n                pFut: 'Future (8,000)'\n            },\n            fr: {\n                title: 'Rapport de prévoyance et pilier 3a',\n                sub: 'Projection séparée du pilier 3a et de la LPP jusqu\\'à la retraite',\n                exp: 'Exporter en PDF',\n                expl: '<strong>Objectif:</strong> Sépare les avoirs du pilier 3a et du 2e pilier. Permet de simuler les futures hausses du plafond légal 3a et mesure l\\'effet de levier des intérêts composés. Tient compte des versements partiels ou flexibles.',\n                p: 'Paramètres',\n                birth: 'Date de naissance',\n                retAge: 'Âge de retraite',\n                m3aMax: 'Plafond légal 3a p.a.',\n                m3aMonth: 'Versement mensuel 3a',\n                r3a: 'Rendement 3a p.a. (%)',\n                mPk: 'Cotisation LPP / Mois',\n                rPk: 'Taux LPP p.a. (%)',\n                ch: 'Évolution jusqu\\'à la retraite',\n                chComp: 'Composition du capital final',\n                tbl: 'Détail annuel',\n                kStart: 'Capital initial',\n                kStartSub: 'Avoir 3a + LPP',\n                kDep: 'Épargne versée',\n                kInt: 'Intérêts composés',\n                kIntSub: 'Intérêts composés totaux',\n                kEnd: 'Capital final (Objectif)',\n                kEndSub: 'Projection à l\\'âge de',\n                ratioPrefix: 'Part:',\n                perMonth: '/Mois',\n                yUnit: 'Ans',\n                ageP: 'Âge',\n                thYr: 'Année',\n                thAge: 'Âge',\n                th3a: 'Pilier 3a',\n                thPk: 'Caisse de pension',\n                thTot: 'Total',\n                thGrw: 'Croissance p.a.',\n                pCur: 'Actuel (7\\'258)',\n                pHike: 'Hausse (7\\'500)',\n                pFut: 'Futur (8\\'000)'\n            },\n            it: {\n                title: 'Rapporto di previdenza e pilastro 3a',\n                sub: 'Proiezione separata del pilastro 3a e della cassa pensione LPP',\n                exp: 'Esporta in PDF',\n                expl: '<strong>Finalità:</strong> Separa rigorosamente il 3° pilastro dalla cassa pensione. Consente di simulare gli aumenti del massimale 3a e proietta la crescita composta nel tempo, supportando anche versamenti parziali.',\n                p: 'Parametri',\n                birth: 'Data di nascita',\n                retAge: 'Età pensionamento',\n                m3aMax: 'Massimale annuo 3a',\n                m3aMonth: 'Versamento mensile 3a',\n                r3a: 'Rendimento 3a p.a. (%)',\n                mPk: 'Contributo LPP / Mese',\n                rPk: 'Interesse LPP p.a. (%)',\n                ch: 'Evoluzione fino al pensionamento',\n                chComp: 'Composizione capitale finale',\n                tbl: 'Dettaglio annuale',\n                kStart: 'Capitale iniziale',\n                kStartSub: 'Saldo 3a + LPP',\n                kDep: 'Versamenti propri',\n                kInt: 'Interessi composti',\n                kIntSub: 'Interessi composti totali',\n                kEnd: 'Capitale finale (Obiettivo)',\n                kEndSub: 'Proiezione all\\'età di',\n                ratioPrefix: 'Quota:',\n                perMonth: '/Mese',\n                yUnit: 'Anni',\n                ageP: 'Età',\n                thYr: 'Anno',\n                thAge: 'Età',\n                th3a: 'Pilastro 3a',\n                thPk: 'Cassa pensione',\n                thTot: 'Totale',\n                thGrw: 'Crescita p.a.',\n                pCur: 'Attuale (7\\'258)',\n                pHike: 'Aumento (7\\'500)',\n                pFut: 'Futuro (8\\'000)'\n            }\n        };\n\n        const t = (k) => (I18N[LANG] && I18N[LANG][k]) || I18N['de'][k] || k;\n        let barChart = null, pieChart = null, lastRes = null;\n\n        function fmt(v) { return api ? api.formatCurrency(v) : 'CHF ' + Math.round(v).toLocaleString('de-CH'); }\n\n        function getAge(bStr) {\n            const b = new Date(bStr), now = new Date();\n            let age = now.getFullYear() - b.getFullYear();\n            if (now.getMonth() < b.getMonth() || (now.getMonth() === b.getMonth() && now.getDate() < b.getDate())) age--;\n            return Math.max(18, age);\n        }\n\n        function syncPair(slideId, numId, cb) {\n            const s = document.getElementById(slideId), n = document.getElementById(numId);\n            s.addEventListener('input', () => { n.value = s.value; cb(); });\n            n.addEventListener('input', () => { s.value = n.value; cb(); });\n        }\n\n        function set3aMax(val) {\n            document.getElementById('slide3aMax').value = val;\n            document.getElementById('num3aMax').value = val;\n            const maxMonthly = Math.round(val / 12);\n            document.getElementById('slideSavings3a').max = maxMonthly;\n            document.getElementById('numSavings3a').max = maxMonthly;\n            const curMonthly = parseFloat(document.getElementById('numSavings3a').value) || 0;\n            if (curMonthly > maxMonthly) {\n                document.getElementById('slideSavings3a').value = maxMonthly;\n                document.getElementById('numSavings3a').value = maxMonthly;\n            }\n            calc();\n        }\n\n        function set3aSavingsRatio(ratio) {\n            const maxVal = parseFloat(document.getElementById('num3aMax').value) || 7258;\n            const monthly = Math.round((maxVal / 12) * ratio);\n            document.getElementById('slideSavings3a').value = monthly;\n            document.getElementById('numSavings3a').value = monthly;\n            calc();\n        }\n\n        function initUI() {\n            document.getElementById('titleText').innerText = t('title');\n            document.getElementById('repSub').innerText = t('sub');\n            document.getElementById('lblPdfBtn').innerText = t('exp');\n            document.getElementById('explText').innerHTML = t('expl');\n            document.getElementById('lblParamTitle').innerText = t('p');\n            document.getElementById('lblBirth').innerText = t('birth');\n            document.getElementById('lblRetAge').innerText = t('retAge');\n            document.getElementById('lbl3aMaxHead').innerText = t('m3aMax');\n            document.getElementById('lbl3aMonthHead').innerText = t('m3aMonth');\n            document.getElementById('lbl3aRateHead').innerText = t('r3a');\n            document.getElementById('lblPkMonthHead').innerText = t('mPk');\n            document.getElementById('lblPkRateHead').innerText = t('rPk');\n            document.getElementById('lblChart1Title').innerText = t('ch');\n            document.getElementById('lblChart2Title').innerText = t('chComp');\n            document.getElementById('lblTableTitle').innerText = t('tbl');\n            document.getElementById('thYr').innerText = t('thYr');\n            document.getElementById('thAge').innerText = t('thAge');\n            document.getElementById('th3a').innerText = t('th3a');\n            document.getElementById('thPk').innerText = t('thPk');\n            document.getElementById('thTot').innerText = t('thTot');\n            document.getElementById('thGrw').innerText = t('thGrw');\n            document.getElementById('btnPresetCur').innerText = t('pCur');\n            document.getElementById('btnPresetHike').innerText = t('pHike');\n            document.getElementById('btnPresetFut').innerText = t('pFut');\n            document.getElementById('lblRatioPrefix').innerText = t('ratioPrefix');\n\n            syncPair('slide3aMax', 'num3aMax', () => {\n                const maxVal = parseFloat(document.getElementById('num3aMax').value);\n                const maxMonthly = Math.round(maxVal / 12);\n                document.getElementById('slideSavings3a').max = maxMonthly;\n                document.getElementById('numSavings3a').max = maxMonthly;\n                const curMonthly = parseFloat(document.getElementById('numSavings3a').value) || 0;\n                if (curMonthly > maxMonthly) {\n                    document.getElementById('slideSavings3a').value = maxMonthly;\n                    document.getElementById('numSavings3a').value = maxMonthly;\n                }\n                calc();\n            });\n            syncPair('slideSavings3a', 'numSavings3a', calc);\n            syncPair('slideRate3a', 'numRate3a', calc);\n            syncPair('slideSavingsPK', 'numSavingsPK', calc);\n            syncPair('slideRatePK', 'numRatePK', calc);\n            document.getElementById('birthdate').addEventListener('input', calc);\n            document.getElementById('retirementAge').addEventListener('input', calc);\n        }\n\n        function calc() {\n            const assets = api ? api.getAllAssets() : [];\n            let s3a = 0, sPK = 0;\n            assets.forEach(a => {\n                const ac = (a.assetClass||'').toLowerCase(), n = (a.name||'').toLowerCase();\n                if (ac.includes('3b') || n.includes('3b')) return;\n                const val = api ? api.getLatestBalanceValue(a) : 0;\n                if (ac.includes('3a') || n.includes('3a')) s3a += val;\n                else if (ac.includes('pension') || n.includes('pension') || n.includes('pk')) sPK += val;\n            });\n\n            const curAge = getAge(document.getElementById('birthdate').value);\n            const retAge = parseInt(document.getElementById('retirementAge').value) || 65;\n            const horizon = Math.max(1, retAge - curAge);\n            document.getElementById('lblHorizonBadge').innerText = `${horizon} ${t('yUnit')} (${t('ageP')} ${retAge})`;\n\n            const max3a = parseFloat(document.getElementById('num3aMax').value);\n            const m3a = parseFloat(document.getElementById('numSavings3a').value);\n            const r3a = parseFloat(document.getElementById('numRate3a').value) / 100;\n            const mPK = parseFloat(document.getElementById('numSavingsPK').value);\n            const rPK = parseFloat(document.getElementById('numRatePK').value) / 100;\n\n            let cur3a = s3a, curPK = sPK, totDep = s3a + sPK, lastTot = cur3a + curPK;\n            const labels = [], d3a = [], dPK = [], rows = [];\n            const startYr = new Date().getFullYear();\n\n            labels.push(`${t('ageP')} ${curAge}`);\n            d3a.push(Math.round(cur3a)); dPK.push(Math.round(curPK));\n            rows.push({ yr: startYr, age: `${t('ageP')} ${curAge}`, v3a: cur3a, vPK: curPK, tot: cur3a + curPK, grw: 0 });\n\n            for (let i = 1; i <= horizon; i++) {\n                cur3a = (cur3a * (1 + r3a)) + (m3a * 12);\n                curPK = (curPK * (1 + rPK)) + (mPK * 12);\n                totDep += (m3a * 12) + (mPK * 12);\n                const tot = cur3a + curPK;\n                labels.push(`${t('ageP')} ${curAge + i}`);\n                d3a.push(Math.round(cur3a)); dPK.push(Math.round(curPK));\n                rows.push({ yr: startYr + i, age: `${t('ageP')} ${curAge + i}`, v3a: cur3a, vPK: curPK, tot, grw: tot - lastTot });\n                lastTot = tot;\n            }\n\n            const finalTot = cur3a + curPK;\n            const finalInt = Math.max(0, finalTot - totDep);\n\n            // KPI Dashboard Grid im FinBundle Design (border-b-4 Akzente)\n            document.getElementById('kpiGrid').innerHTML = `\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-slate-400 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-slate-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\"></path></svg>\n                        <span>${t('kStart')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-slate-900 dark:text-white truncate font-mono\">${fmt(s3a + sPK)}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${t('kStartSub')}</div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-blue-500 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-blue-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 4v16m8-8H4\"></path></svg>\n                        <span>${t('kDep')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-blue-600 dark:text-blue-400 truncate font-mono\">${fmt(totDep)}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${fmt(m3a + mPK)}${t('perMonth')}</div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-amber-500 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-amber-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path></svg>\n                        <span>${t('kInt')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-amber-600 dark:text-amber-400 truncate font-mono\">${fmt(finalInt)}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${t('kIntSub')}</div>\n                </div>\n\n                <div class=\"bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 p-6 rounded-2xl shadow-sm border-b-4 border-b-emerald-500 overflow-hidden\">\n                    <div class=\"text-gray-500 dark:text-gray-400 text-xs font-bold uppercase tracking-wider mb-2 flex items-center gap-2\">\n                        <svg class=\"w-3.5 h-3.5 text-emerald-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                        <span>${t('kEnd')}</span>\n                    </div>\n                    <div class=\"font-black text-2xl text-emerald-600 dark:text-emerald-400 truncate font-mono\">${fmt(finalTot)}</div>\n                    <div class=\"text-xs text-gray-400 mt-2 font-medium\">${t('kEndSub')} ${retAge}</div>\n                </div>\n            `;\n\n            document.getElementById('lblRowCountBadge').innerText = `${rows.length} ${t('yUnit')}`;\n            document.getElementById('tableBody').innerHTML = rows.map((r, idx) => `\n                <tr class=\"${idx === rows.length - 1 ? 'bg-blue-50/70 dark:bg-blue-950/40 font-black' : 'hover:bg-gray-50/80 dark:hover:bg-slate-800/40'} transition-colors\">\n                    <td class=\"p-3.5 font-sans font-bold text-slate-800 dark:text-slate-200\">${r.yr}</td>\n                    <td class=\"p-3.5 text-gray-500 dark:text-gray-400\">${r.age}</td>\n                    <td class=\"p-3.5 text-right text-emerald-700 dark:text-emerald-400 font-bold\">${fmt(r.v3a)}</td>\n                    <td class=\"p-3.5 text-right text-blue-700 dark:text-blue-400 font-bold\">${fmt(r.vPK)}</td>\n                    <td class=\"p-3.5 text-right font-black text-slate-900 dark:text-white\">${fmt(r.tot)}</td>\n                    <td class=\"p-3.5 text-right font-bold text-emerald-600 dark:text-emerald-400\">+${fmt(r.grw)}</td>\n                </tr>\n            `).join('');\n\n            // Chart 1: Bar Chart (Animation false für PDF-Export)\n            const ctx1 = document.getElementById('forecastChart').getContext('2d');\n            if (barChart) barChart.destroy();\n            barChart = new Chart(ctx1, {\n                type: 'bar',\n                data: {\n                    labels,\n                    datasets: [\n                        { label: t('th3a'), data: d3a, backgroundColor: '#059669', stack: 't' },\n                        { label: t('thPk'), data: dPK, backgroundColor: '#2563eb', stack: 't' }\n                    ]\n                },\n                options: {\n                    animation: false,\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        x: { stacked: true, grid: { display: false } },\n                        y: { stacked: true, grid: { color: '#f1f5f9' }, ticks: { callback: v => fmt(v) } }\n                    }\n                }\n            });\n\n            // Chart 2: Doughnut Composition\n            const ctx2 = document.getElementById('compositionChart').getContext('2d');\n            if (pieChart) pieChart.destroy();\n            pieChart = new Chart(ctx2, {\n                type: 'doughnut',\n                data: {\n                    labels: [t('kDep'), t('kInt')],\n                    datasets: [{\n                        data: [Math.round(totDep), Math.round(finalInt)],\n                        backgroundColor: ['#2563eb', '#f59e0b']\n                    }]\n                },\n                options: {\n                    animation: false,\n                    responsive: true,\n                    maintainAspectRatio: false\n                }\n            });\n\n            lastRes = { s3a, sPK, totDep, finalTot, finalInt, curAge, retAge, m3a, r3a, mPK, rPK, max3a, rows };\n        }\n\n        // PDF Export über FinSPA PdfToolkit Bridge\n        document.getElementById('pdfBtn').addEventListener('click', async () => {\n            if (!lastRes) return;\n            await api.exportPdfReport({\n                title: t('title'),\n                subtitle: `${t('sub')} (${t('ageP')} ${lastRes.curAge} - ${lastRes.retAge})`,\n                kpis: [\n                    { label: t('kStart'), value: fmt(lastRes.s3a + lastRes.sPK), color: '#64748b' },\n                    { label: t('kDep'), value: fmt(lastRes.totDep), color: '#2563eb' },\n                    { label: t('kInt'), value: fmt(lastRes.finalInt), color: '#d97706' },\n                    { label: t('kEnd'), value: fmt(lastRes.finalTot), color: '#059669' }\n                ],\n                parameters: [\n                    {\n                        group: t('th3a'),\n                        items: [\n                            { label: t('m3aMax'), value: fmt(lastRes.max3a) },\n                            { label: t('m3aMonth'), value: fmt(lastRes.m3a) },\n                            { label: t('r3a'), value: (lastRes.r3a*100).toFixed(1)+'% p.a.' }\n                        ]\n                    },\n                    {\n                        group: t('thPk'),\n                        items: [\n                            { label: t('mPk'), value: fmt(lastRes.mPK) },\n                            { label: t('rPk'), value: (lastRes.rPk*100).toFixed(1)+'% p.a.' }\n                        ]\n                    }\n                ],\n                chartsData: await api.captureAllCharts(),\n                tableHeaders: [t('thYr'), t('thAge'), t('th3a'), t('thPk'), t('thTot'), t('thGrw')],\n                tableBody: lastRes.rows.map(r => [String(r.yr), r.age, fmt(r.v3a), fmt(r.vPK), fmt(r.tot), `+${fmt(r.grw)}`])\n            });\n        });\n\n        initUI();\n        calc();\n    </script>\n</body>\n</html>",
